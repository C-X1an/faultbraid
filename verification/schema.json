{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FaultBraid command evidence",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "category",
    "command",
    "cwd",
    "started_utc",
    "ended_utc",
    "duration_seconds",
    "status",
    "exit_code",
    "environment",
    "source",
    "stdout",
    "stderr"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "git_commit",
        "git_dirty",
        "source_tree_sha256",
        "files"
      ]
    },
    "stdout": {
      "$ref": "#/$defs/output"
    },
    "stderr": {
      "$ref": "#/$defs/output"
    }
  },
  "$defs": {
    "output": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
