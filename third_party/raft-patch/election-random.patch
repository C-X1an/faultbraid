 func (r *raft) resetRandomizedElectionTimeout() {
-	r.randomizedElectionTimeout = r.electionTimeout + globalRand.Intn(r.electionTimeout)
+	offset := 0
+	if r.electionRandom == nil {
+		offset = globalRand.Intn(r.electionTimeout)
+	} else {
+		offset = r.electionRandom(r.electionTimeout)
+		if offset < 0 || offset >= r.electionTimeout {
+			r.logger.Panicf("election random result %d is outside [0,%d)", offset, r.electionTimeout)
+		}
+	}
+	r.randomizedElectionTimeout = r.electionTimeout + offset
