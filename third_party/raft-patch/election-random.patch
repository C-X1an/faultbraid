+func TestElectionRandomInjection(t *testing.T) {
+	choices := []int{3, 7, 0}
+	calls := 0
+	cfg := newTestConfig(1, 10, 1, newTestMemoryStorage(withPeers(1)))
+	cfg.ElectionRandom = func(n int) int {
+		assert.Equal(t, 10, n)
+		choice := choices[calls]
+		calls++
+		return choice
+	}
+	r := newRaft(cfg)
+	assert.Equal(t, 13, r.randomizedElectionTimeout)
+	r.resetRandomizedElectionTimeout()
+	assert.Equal(t, 17, r.randomizedElectionTimeout)
+	r.resetRandomizedElectionTimeout()
+	assert.Equal(t, 10, r.randomizedElectionTimeout)
+	assert.Equal(t, len(choices), calls)
+}
+
+func TestElectionRandomInjectionRejectsOutOfRange(t *testing.T) {
+	for _, choice := range []int{-1, 10} {
+		t.Run(fmt.Sprintf("choice=%d", choice), func(t *testing.T) {
+			defer func() {
+				if recover() == nil {
+					t.Fatalf("expected panic for election random choice %d", choice)
+				}
+			}()
+			cfg := newTestConfig(1, 10, 1, newTestMemoryStorage(withPeers(1)))
+			cfg.ElectionRandom = func(n int) int {
+				assert.Equal(t, 10, n)
+				return choice
+			}
+			newRaft(cfg)
+		})
+	}
+}
